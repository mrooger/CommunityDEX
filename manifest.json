{
  "manifest_version": 3,
  "name": "Community Dex",
  "short_name": "Community Dex",
  "version": "1.1.0",
  "version_name": "1.1.0",
  "description": "Pokédex, Hunt, Capturas e Shinies em um painel personalizável para Poke Idle World.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Community Dex",
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://pokeapi.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://poke.idleworld.online/*"
      ],
      "js": [
        "main-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://poke.idleworld.online/*"
      ],
      "js": [
        "core.js",
        "app.js"
      ],
      "css": [
        "app.css"
      ],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon128.png"
      ],
      "matches": [
        "https://poke.idleworld.online/*"
      ]
    }
  ]
}
